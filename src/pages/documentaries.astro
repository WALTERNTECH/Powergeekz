---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import VideoCard from "../components/VideoCard.astro";
import Icon from "../components/Icon.astro";
import { gallery, galleryGroups, videos } from "../data/media";
import { photo } from "../data/photos";

const groupLabel = Object.fromEntries(galleryGroups.map((g) => [g.id, g.label]));
const items = await Promise.all(
  gallery.map(async (g) => {
    const src = photo(g.name);
    const full = await getImage({ src, width: Math.min(1600, src.width), format: "webp", quality: 82 });
    return { ...g, src, full: full.src, label: groupLabel[g.group] };
  }),
);
const counts = Object.fromEntries(galleryGroups.map((g) => [g.id, gallery.filter((i) => i.group === g.id).length]));
---
<Base
  title="Documentaries"
  description="Photographs and site footage of Powergeekz Engineering installations: solar PV, inverters and lithium storage, UPS, switchgear and solar water heating across Kenya."
  path="/documentaries.html"
>
  <PageHero
    eyebrow="Documentaries"
    title="From the field."
    lead="A working record of our installations, photographed and filmed on site by the engineers who did the work."
  >
    <div class="jump" data-reveal style="--d:180ms">
      <a href="#footage" class="link-arrow">Site footage <Icon name="arrow-up-right" /></a>
      <a href="#photographs" class="link-arrow">Photographs <Icon name="arrow-up-right" /></a>
    </div>
  </PageHero>

  <!-- ── Footage ──────────────────────────────────────── -->
  <section class="section" id="footage">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack" data-reveal>
          <span class="eyebrow">Site footage</span>
          <h2 class="h2">Installations as they happen.</h2>
        </div>
        <p class="lead" data-reveal style="--d:100ms">Short, unedited clips recorded during installation and commissioning. Tap any clip to play.</p>
      </div>
      <div class="videos">
        {videos.map((v, i) => (
          <div data-reveal style={`--d:${(i % 4) * 80}ms`}><VideoCard {...v} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Photographs ──────────────────────────────────── -->
  <section class="section section--alt" id="photographs">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack" data-reveal>
          <span class="eyebrow">Photographs</span>
          <h2 class="h2">The work, up close.</h2>
        </div>
        <p class="lead" data-reveal style="--d:100ms">Select any photograph to view it full size. Use the arrow keys or swipe to move through the set.</p>
      </div>

      <div class="filters" role="toolbar" aria-label="Filter photographs" data-reveal>
        <button type="button" class="filter is-active" data-gfilter="all" aria-pressed="true">All <span>{items.length}</span></button>
        {galleryGroups.map((g) => (
          <button type="button" class="filter" data-gfilter={g.id} aria-pressed="false">{g.label} <span>{counts[g.id]}</span></button>
        ))}
      </div>

      <ul role="list" class="gallery" data-gallery>
        {items.map((item, i) => (
          <li data-group={item.group}>
            <button type="button" class="shot" data-full={item.full} data-caption={item.label} aria-label={`View photograph ${i + 1}: ${item.label}`}>
              <Image
                src={item.src}
                alt={`${item.label} installation by Powergeekz Engineering`}
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 31vw, 48vw"
              />
              <span class="shot__zoom" aria-hidden="true"><Icon name="expand" size={16} /></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Photograph viewer">
    <div class="lightbox__bar">
      <span class="lightbox__caption" data-lb-caption></span>
      <span class="lightbox__count" data-lb-count></span>
      <button type="button" class="lightbox__btn" data-lb-close aria-label="Close"><Icon name="x" size={20} /></button>
    </div>
    <div class="lightbox__stage" data-lb-stage>
      <img data-lb-img alt="" />
    </div>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Previous photograph"><Icon name="chevron-left" size={22} /></button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lb-next aria-label="Next photograph"><Icon name="chevron-right" size={22} /></button>
  </dialog>

  <CtaBand title="Want this standard on your site?" />
</Base>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-gfilter]");
  const tiles = [...document.querySelectorAll<HTMLLIElement>("[data-gallery] > li")];

  filterButtons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.gfilter!;
      filterButtons.forEach((b) => {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-pressed", String(b === btn));
      });
      let n = 0;
      tiles.forEach((tile) => {
        const show = f === "all" || tile.dataset.group === f;
        tile.hidden = !show;
        if (show && n++ < 12) {
          tile.animate([{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }], {
            duration: 420, delay: n * 30, easing: "cubic-bezier(.16,1,.3,1)", fill: "backwards",
          });
        }
      });
    }),
  );

  // Lightbox on a native <dialog>: focus trapping, Escape and backdrop come for free.
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]")!;
  const img = dialog.querySelector<HTMLImageElement>("[data-lb-img]")!;
  const caption = dialog.querySelector<HTMLElement>("[data-lb-caption]")!;
  const count = dialog.querySelector<HTMLElement>("[data-lb-count]")!;
  let list: HTMLButtonElement[] = [];
  let index = 0;

  function show(i: number) {
    index = (i + list.length) % list.length;
    const shot = list[index];
    img.classList.remove("is-loaded");
    img.onload = () => img.classList.add("is-loaded");
    img.src = shot.dataset.full!;
    img.alt = shot.querySelector("img")?.alt ?? "";
    caption.textContent = shot.dataset.caption ?? "";
    count.textContent = `${index + 1} / ${list.length}`;
  }

  document.querySelector("[data-gallery]")?.addEventListener("click", (e) => {
    const shot = (e.target as HTMLElement).closest<HTMLButtonElement>(".shot");
    if (!shot) return;
    list = tiles.filter((t) => !t.hidden).map((t) => t.querySelector<HTMLButtonElement>(".shot")!);
    show(list.indexOf(shot));
    dialog.showModal();
    document.documentElement.classList.add("lightbox-open");
  });

  dialog.querySelector("[data-lb-close]")!.addEventListener("click", () => dialog.close());
  dialog.querySelector("[data-lb-prev]")!.addEventListener("click", () => show(index - 1));
  dialog.querySelector("[data-lb-next]")!.addEventListener("click", () => show(index + 1));
  dialog.addEventListener("close", () => document.documentElement.classList.remove("lightbox-open"));
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog || (e.target as HTMLElement).matches("[data-lb-stage]")) dialog.close();
  });
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") show(index + 1);
    if (e.key === "ArrowLeft") show(index - 1);
  });

  let startX = 0;
  dialog.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .stack { display: grid; gap: 18px; align-content: start; justify-items: start; }
  .jump { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 8px; }

  .videos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 14px; }
  @media (min-width: 900px) { .videos { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 20px; } }


  .gallery { columns: 2; column-gap: 12px; }
  @media (min-width: 1024px) { .gallery { columns: 3; column-gap: 18px; } }
  .gallery li { break-inside: avoid; margin-bottom: 12px; }
  @media (min-width: 1024px) { .gallery li { margin-bottom: 18px; } }
  .gallery li[hidden] { display: none; }
  .shot {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-3);
  }
  .shot :global(img) { width: 100%; transition: transform 1.2s var(--ease-out); }
  .shot:hover :global(img) { transform: scale(1.04); }
  .shot__zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .shot:hover .shot__zoom, .shot:focus-visible .shot__zoom { opacity: 1; transform: none; }

  .lightbox {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(7, 8, 11, 0.96);
    color: #fff;
    overflow: hidden;
  }
  .lightbox[open] { display: grid; grid-template-rows: auto 1fr; animation: lb-in 0.3s var(--ease); }
  .lightbox::backdrop { background: rgba(7, 8, 11, 0.6); }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  :global(html.lightbox-open) { overflow: hidden; }
  .lightbox__bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px var(--gutter);
    padding-top: max(14px, env(safe-area-inset-top));
  }
  .lightbox__caption { font-weight: 500; }
  .lightbox__count { margin-right: auto; color: var(--night-muted); font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .lightbox__btn {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
    transition: background-color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .lightbox__btn:hover { background: var(--blue); border-color: var(--blue); }
  .lightbox__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 var(--gutter) max(24px, env(safe-area-inset-bottom));
  }
  .lightbox__stage img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 10px;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .lightbox__stage img:global(.is-loaded) { opacity: 1; }
  .lightbox__nav { position: absolute; top: 50%; margin-top: -23px; }
  .lightbox__nav--prev { left: 16px; }
  .lightbox__nav--next { right: 16px; }
  @media (max-width: 767px) {
    .lightbox__nav { top: auto; bottom: max(20px, env(safe-area-inset-bottom)); margin: 0; }
    .lightbox__stage { padding-bottom: 88px; }
  }
</style>
