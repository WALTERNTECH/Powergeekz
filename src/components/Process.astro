---
interface Props {
  eyebrow?: string;
  title?: string;
}
const { eyebrow = "How we work", title = "Four stages. One accountable team." } = Astro.props;

const steps = [
  { title: "Survey", text: "An engineer visits, measures the loads and reviews what is already installed. There is no charge for the assessment." },
  { title: "Design", text: "We specify the system, equipment and protection, and issue a written proposal you can hold us to." },
  { title: "Install & commission", text: "Our own technicians install, test under load and hand over with full documentation." },
  { title: "Maintain", text: "Preventive maintenance on a schedule, and response when it matters, for the life of the system." },
];
---
<section class="section process">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h2">{title}</h2>
    </div>
    <ol role="list" class="steps">
      {steps.map((s, i) => (
        <li class="step" data-reveal style={`--d:${i * 100}ms`}>
          <span class="step__num">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="h3">{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .step {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) { .step { padding: 32px 32px 0 0; } }
  .step::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    width: 0;
    height: 2px;
    background: var(--blue);
    transition: width 1.2s var(--ease-out);
    transition-delay: calc(var(--d, 0ms) + 200ms);
  }
  .step:global(.is-in)::before { width: 56px; }
  :global(html:not(.js)) .step::before { width: 56px; }
  .step__num {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    margin-bottom: 18px;
  }
</style>
