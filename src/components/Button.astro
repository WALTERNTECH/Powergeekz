---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  variant?: "primary" | "dark" | "light" | "ghost";
  size?: "md" | "sm";
  block?: boolean;
  icon?: string | false;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = "primary", size = "md", block = false, icon = "arrow-right", class: extra, ...rest } = Astro.props;
const classes = [
  "btn",
  variant !== "primary" && `btn--${variant}`,
  size === "sm" && "btn--sm",
  block && "btn--block",
  extra,
].filter(Boolean).join(" ");
---
<a href={href} class={classes} {...rest}>
  <span><slot /></span>
  {icon && <span class="btn__icon"><Icon name={icon} size={16} /></span>}
</a>
