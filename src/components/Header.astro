---
import { Image } from "astro:assets";
import emblem from "../assets/brand/emblem.png";
import { nav, cta, company } from "../data/site";
import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  current: string;
}
const { current } = Astro.props;
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Powergeekz Engineering, home">
      <Image src={emblem} alt="" width={88} height={88} class="brand__mark" loading="eager" fetchpriority="high" />
      <span class="brand__text">
        <span class="brand__name">Powergeekz</span>
        <span class="brand__sub">Engineering Ltd</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={cta.href} size="sm" class="header-cta">{cta.label}</Button>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="visually-hidden">Open menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Kept outside the header: a backdrop-filter on the header would trap this fixed panel. -->
<div id="mobile-menu" class="mobile-menu" data-menu hidden>
  <div class="mobile-menu__inner container">
    <nav aria-label="Mobile">
      <ol role="list" class="mobile-menu__list">
        <li style="--i:0">
          <a href="/" aria-current={current === "/" ? "page" : undefined}>
            <span class="mobile-menu__num">00</span><span class="mobile-menu__label">Home</span><Icon name="arrow-up-right" size={20} />
          </a>
        </li>
        {nav.map((item, i) => (
          <li style={`--i:${i + 1}`}>
            <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
              <span class="mobile-menu__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="mobile-menu__label">{item.label}</span>
              <Icon name="arrow-up-right" size={20} />
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="mobile-menu__foot" style="--i:7">
      <Button href={cta.href} block>{cta.label}</Button>
      <div class="mobile-menu__contact">
        <a href={company.phones[0].href}><Icon name="phone" size={16} />{company.phones[0].label}</a>
        <a href={company.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />WhatsApp</a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: rgba(255, 255, 255, 0);
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .site-header[data-scrolled],
  :global(html.menu-open) .site-header {
    background: rgba(255, 255, 255, 0.86);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
  }
  :global(html.menu-open) .site-header { background: #fff; }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex: none;
    margin-right: auto;
  }
  .brand__mark {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line), var(--shadow-sm);
  }
  .brand__text { display: grid; line-height: 1; gap: 5px; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .brand__sub {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .primary-nav ul { display: flex; align-items: center; gap: 4px; }
  .primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 450;
    color: var(--ink-2);
    transition: color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .primary-nav a:hover { color: var(--ink); background: var(--paper-2); }
  .primary-nav a[aria-current="page"] { color: var(--ink); font-weight: 550; }
  .primary-nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--blue);
  }

  .site-header__actions { display: flex; align-items: center; gap: 12px; flex: none; }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: #fff;
    place-items: center;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .menu-toggle:hover { border-color: var(--ink); }
  .menu-toggle__bars { position: relative; width: 16px; height: 10px; display: block; }
  .menu-toggle__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.6px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.4s var(--ease), top 0.4s var(--ease);
  }
  .menu-toggle__bars span:first-child { top: 0; }
  .menu-toggle__bars span:last-child { top: calc(100% - 1.6px); }
  .menu-toggle[aria-expanded="true"] { background: var(--ink); border-color: var(--ink); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span { background: #fff; top: calc(50% - 0.8px); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:first-child { transform: rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:last-child { transform: rotate(-45deg); }

  @media (max-width: 1099px) {
    .primary-nav { display: none; }
    .menu-toggle { display: grid; }
  }
  @media (max-width: 639px) {
    .header-cta { display: none; }
    .brand__mark { width: 38px; height: 38px; }
    .brand__name { font-size: 1.1rem; }
    .brand__sub { font-size: 0.6rem; }
  }

  /* ── Mobile menu ─────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 99;
    background: #fff;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease);
  }
  .mobile-menu[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .mobile-menu.is-open { opacity: 1; transform: none; visibility: visible; pointer-events: auto; }
  .mobile-menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding-top: 12px;
    padding-bottom: max(28px, env(safe-area-inset-bottom));
  }
  .mobile-menu__list li {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
    transition-delay: calc(var(--i) * 45ms + 60ms);
  }
  .mobile-menu.is-open .mobile-menu__list li,
  .mobile-menu.is-open .mobile-menu__foot { opacity: 1; transform: none; }
  .mobile-menu__list a {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 2px;
    color: var(--ink);
  }
  .mobile-menu__num {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--subtle);
    font-variant-numeric: tabular-nums;
    width: 22px;
  }
  .mobile-menu__label {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 7vw, 2.2rem);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .mobile-menu__list a :global(svg) { color: var(--subtle); transition: transform 0.35s var(--ease), color 0.35s var(--ease); }
  .mobile-menu__list a:hover :global(svg),
  .mobile-menu__list a[aria-current="page"] :global(svg) { color: var(--blue); transform: translate(2px, -2px); }
  .mobile-menu__list a[aria-current="page"] .mobile-menu__num,
  .mobile-menu__list a[aria-current="page"] .mobile-menu__label { color: var(--blue); }

  .mobile-menu__foot {
    display: grid;
    gap: 16px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease) 0.36s, transform 0.6s var(--ease) 0.36s;
  }
  .mobile-menu__contact { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .mobile-menu__contact a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 50px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }
  @media (min-width: 1100px) {
    .mobile-menu { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu__list li, .mobile-menu__foot { transition: none; }
  }
</style>
